// หาโค้ดส่วนที่คุณสร้างนิยาย แล้วแก้เป็นแบบนี้ครับ:

novelRoute.post('/', async (c) => {
    // ... (โค้ดดึงข้อมูล title, description จาก c.req.json() และ user id เหมือนเดิม) ...

    try {
        // 🌟 1. เติมคำว่า RETURNING id เข้าไปท้ายคำสั่ง SQL
        const result = await c.env.DB.prepare(
            `INSERT INTO novels (title, description, category, owner_id) VALUES (?, ?, ?, ?) RETURNING id`
        ).bind(body.title, body.description, body.category, user.id).first(); 
        // 💡 (ใช้ .first() เพื่อดึงค่า ID แถวแรกที่เพิ่งสร้างออกมา)

        // 🌟 2. ส่ง ID กลับไปให้ Frontend
        return c.json({ 
            message: 'สร้างนิยายสำเร็จ', 
            id: result?.id  // ส่ง id คืนไปในชื่อตัวแปร "id"
        });

    } catch (e) {
        return c.json({ error: 'สร้างนิยายไม่สำเร็จ' }, 500);
    }
});